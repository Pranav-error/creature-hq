rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player: users/{uid} holds their whole save.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schema', 'rev', 'session', 'save', 'createdAt', 'updatedAt'])
          && d.schema == 1
          && d.rev is int && d.rev >= 0
          && d.session is string && d.session.size() <= 64
          && d.save is map
          && d.save.keys().hasOnly(['done', 'streak', 'lastDate', 'extra', 'subs', 'notes', 'quiz', 'pet', 'rulesSeen', 'dataVersion'])
          && d.createdAt is timestamp
          && d.updatedAt == request.time;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validSave();

      // Workshop projects: one document per project, three files of up to ~100 KB each.
      match /projects/{pid} {
        function validProject() {
          let d = request.resource.data;
          return pid.size() <= 40
            && d.keys().hasOnly(['name', 'files', 'questId', 'createdAt', 'updatedAt'])
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
            && (d.questId == null || (d.questId is string && d.questId.size() <= 16))
            && d.files is map && d.files.keys().hasOnly(['html', 'css', 'js'])
            && d.files.html is string && d.files.html.size() <= 100000
            && d.files.css is string && d.files.css.size() <= 100000
            && d.files.js is string && d.files.js.size() <= 100000
            && d.createdAt is timestamp
            && d.updatedAt == request.time;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && validProject();
      }
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
